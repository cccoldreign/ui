{
  "database": {
    "dialect": "sqlite",
    "path": "example.sqlite"
  },
  "active_table": "employees",
  "tables": [
    {
      "name": "employees",
      "source": {
        "table": "employees",
        "alias": "e",
        "primary_key": "id"
      },
      "query": {
        "mode": "table",
        "joins": [
          "LEFT JOIN enterprises ent ON ent.id = e.enterprise_id"
        ],
        "order_by": [
          {
            "column": "id",
            "direction": "ASC"
          }
        ]
      },
      "columns": [
        {
          "name": "id",
          "title": "ID",
          "field": "e.id",
          "type": "integer",
          "visible": true,
          "editable": false,
          "filterable": true,
          "sortable": true,
          "width": 70
        },
        {
          "name": "last_name",
          "title": "Фамилия",
          "field": "e.last_name",
          "update_field": "last_name",
          "type": "text",
          "visible": true,
          "editable": true,
          "filterable": true,
          "sortable": true
        },
        {
          "name": "first_name",
          "title": "Имя",
