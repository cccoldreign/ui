        "editable": true,
        "enable_context_menu": true,
        "resize_columns_to_contents": false
      }
    },
    {
      "name": "enterprise_directory",
      "source": {},
      "query": {
        "mode": "select",
        "sql": "SELECT e.id, e.last_name, e.first_name, ent.name AS enterprise_name FROM employees e LEFT JOIN enterprises ent ON ent.id = e.enterprise_id WHERE e.active = ?",
        "params": [
          true
        ],
        "order_by": [
          {
            "column": "last_name",
            "direction": "ASC"
          },
          {
            "column": "first_name",
            "direction": "ASC"
          }
        ]
      },
      "columns": [
